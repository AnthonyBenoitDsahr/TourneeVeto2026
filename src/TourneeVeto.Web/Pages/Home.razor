@page "/"
@using TourneeVeto.Domain
@using TourneeVeto.Domain.Visits

<PageTitle>Tournée du jour | TournéeVéto</PageTitle>

<div class="home-page">
    <header class="page-heading">
        <p class="eyebrow">Santé du troupeau</p>
        <h1>Votre tournée, en un seul endroit.</h1>
        <p class="intro">
            Préparez vos visites, retrouvez les informations utiles et gardez le fil de vos suivis.
        </p>
        <span class="demo-badge">Mode démonstration</span>
    </header>

    <aside class="demo-notice" aria-label="Avis sur les données de démonstration">
        <span class="notice-icon" aria-hidden="true">i</span>
        <p>
            Les élevages et les animaux présentés ici sont fictifs. Ce prototype ne fournit pas
            d'avis clinique et ne remplace pas le jugement vétérinaire.
        </p>
    </aside>

    <section class="tour-panel" aria-labelledby="tour-title">
        <div class="tour-copy">
            <p class="eyebrow">Espace de travail</p>
            <h2 id="tour-title">Tournée de démonstration</h2>
            <p>
                Explorez des fiches fictives et découvrez les étapes prévues pour documenter une visite.
            </p>
            <div class="tour-actions">
                <a class="button button-primary" href="#elevages">Voir les élevages</a>
                <a class="button button-secondary" href="#parcours">Découvrir le parcours</a>
            </div>
        </div>
        <div class="tour-summary" aria-label="Résumé des données de démonstration">
            <span class="summary-number">@demoFarms.Count</span>
            <span class="summary-label">élevages fictifs</span>
            <span class="summary-divider" aria-hidden="true"></span>
            <span class="summary-number">@demoFarms.Sum(farm => farm.CowCount)</span>
            <span class="summary-label">animaux fictifs</span>
        </div>
    </section>

    <section id="elevages" class="content-section" aria-labelledby="farms-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Données locales de démonstration</p>
                <h2 id="farms-title">Élevages</h2>
            </div>
            <span class="count-badge">@demoFarms.Count au total</span>
        </div>

        <div class="farm-grid">
            @foreach (var farm in demoFarms)
            {
                <article class="farm-card" @key="farm.Id">
                    <div class="farm-card-heading">
                        <span class="farm-icon" aria-hidden="true">É</span>
                        <span class="farm-count">@farm.CowCount animaux</span>
                    </div>
                    <h3>@farm.Name</h3>
                    <p class="farm-location">@farm.Municipality</p>
                    <a class="text-link" href="#parcours">
                        Découvrir les étapes
                        <span class="visually-hidden"> pour @farm.Name</span>
                        <span aria-hidden="true">→</span>
                    </a>
                </article>
            }
        </div>
    </section>

    <section id="parcours" class="content-section journey-section" aria-labelledby="journey-title">
        <div class="section-heading">
            <div>
                <p class="eyebrow">Du début à la clôture</p>
                <h2 id="journey-title">Le parcours d’une visite</h2>
            </div>
        </div>

        <ol class="journey-list">
            <li>
                <span class="step-number" aria-hidden="true">1</span>
                <div>
                    <h3>Préparer</h3>
                    <p>Choisir un élevage et consulter les informations de la visite.</p>
                </div>
            </li>
            <li>
                <span class="step-number" aria-hidden="true">2</span>
                <div>
                    <h3>Consigner</h3>
                    <p>Suivre les actions de régie et compléter le bilan de biosécurité.</p>
                </div>
            </li>
            <li>
                <span class="step-number" aria-hidden="true">3</span>
                <div>
                    <h3>Documenter</h3>
                    <p>Rédiger le rapport de visite et préparer son export en PDF.</p>
                </div>
            </li>
        </ol>
    </section>

    <footer class="home-footer">
        Données fictives uniquement · Prototype de démonstration
    </footer>
</div>

@code {
    private const int DemoSeed = 20261009;

    private readonly IReadOnlyList<Farm> demoFarms =
        DemoData.Generate(DateOnly.FromDateTime(DateTime.Today), DemoSeed).Farms;
}
